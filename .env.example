# Clippy Environment Variables

# Authentication
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role

# OAuth credential encryption
# Generate once with: openssl rand -base64 32
# Keep server-only. Rotating it requires re-encrypting existing credentials.
INTEGRATION_ENCRYPTION_KEY=base64_encoded_32_byte_key

# OAuth - Google
# Use the values only (no KEY= prefix and no quotes).
# Client IDs end in .apps.googleusercontent.com; secrets commonly start GOCSPX-.
# Configure both variables for Production and for any Preview branch used to
# test OAuth. The authorised callback must match NEXT_PUBLIC_APP_URL exactly.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# OAuth - WhatsApp Cloud API / Meta Embedded Signup
# Meta Valid OAuth Redirect URI:
# https://useclippy.com/api/integrations/whatsapp/callback
# Meta webhook callback:
# https://useclippy.com/api/webhooks/whatsapp
WHATSAPP_APP_ID=your_meta_app_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_CONFIG_ID=your_embedded_signup_configuration_id
WHATSAPP_VERIFY_TOKEN=generate_a_strong_random_verify_token

# Composio - optional WhatsApp Business and CRM onboarding for the pilot.
# When both values are present, /api/integrations/whatsapp uses Composio.
# Keep the API key server-only. Create the WHATSAPP auth config in Composio.
COMPOSIO_API_KEY=your_composio_project_api_key
COMPOSIO_WHATSAPP_AUTH_CONFIG_ID=your_composio_whatsapp_auth_config_id
# Follow Up Boss does not offer a Composio-managed app. Create a custom OAuth2
# or API-key auth config in Composio, then place only its auth config ID here.
COMPOSIO_FOLLOW_UP_BOSS_AUTH_CONFIG_ID=your_composio_follow_up_boss_auth_config_id
# Optional; the default is https://backend.composio.dev/api/v3.1
# COMPOSIO_API_BASE_URL=https://backend.composio.dev/api/v3.1

# OAuth - Microsoft 365 / Outlook
# Microsoft Entra redirect URI:
# https://useclippy.com/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=your_microsoft_entra_application_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_entra_client_secret
# Use common for work/school and personal Microsoft accounts, or a tenant ID
# to restrict access to one Microsoft 365 organisation.
MICROSOFT_TENANT_ID=common

# AI generation - Ollama Cloud or a public Ollama server
# Gmail and Calendar knowledge embeddings are generated locally in the app and
# do not require a separate embedding API or model.
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_BASE_URL=https://ollama.com

# App
NEXT_PUBLIC_APP_URL=https://useclippy.com
# Local development only. This is ignored when NODE_ENV=production.
ENABLE_TEST_AUTH_BYPASS=false

# Billing — leave checkout disabled until Stripe products, webhook delivery, and
# the Control Centre migration have been verified in the target environment.
ENABLE_PAID_CHECKOUT=false
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PROFESSIONAL_PRICE_ID=price_professional
STRIPE_AGENCY_PRICE_ID=price_agency

# Internal automation
CRON_SECRET=generate_a_strong_random_secret
INTERNAL_API_SECRET=generate_a_different_strong_random_secret
TEST_EMAIL=your_test_account_email
TEST_PASSWORD=your_test_account_password
