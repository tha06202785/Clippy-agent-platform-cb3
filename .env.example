# Clippy Environment Configuration Template
# Copy to .env.local and fill in real values
# NEVER commit real secrets

# Clerk (Test Mode for staging, Production for prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_HERE

# Supabase (Use separate projects for staging vs production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_KEY_HERE

# Stripe (Test mode keys for staging)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
STRIPE_SOLO_PRICE_ID=price_xxx
STRIPE_PROFESSIONAL_PRICE_ID=price_xxx
STRIPE_TEAM_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxx

# OAuth (App IDs from provider consoles)
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_VERIFY_TOKEN=your_verify_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# AI Service
OLLAMA_API_KEY=your_api_key
OLLAMA_MODEL=llama3.2

# Monitoring
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx

# App URL (changes per environment)
NEXT_PUBLIC_APP_URL=http://localhost:3000
